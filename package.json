{
  "name": "@pshevche/act-test-runner",
  "version": "1.0.2",
  "description": "Convention wrapper around https://github.com/nektos/act for e2e testing GitHub actions",
  "author": "Pavlo Shevchenko",
  "keywords": [
    "github",
    "github actions",
    "act",
    "nektos act",
    "testing"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pshevche/act-test-runner"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-5": "npm:typescript@^5.9.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "typescript": "^5.0.0-0 || ^6.0.0-0 || ^7.0.0-0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.package.json",
    "clean": "rm -r dist",
    "lint:fix": "eslint .",
    "prettier:fix": "prettier --write .",
    "license:fix": "addlicense -c \"original authors\" -l mit -v src/",
    "lint:check": "eslint . --max-warnings 0 --flag unstable_native_nodejs_ts_config",
    "prettier:check": "prettier --check .",
    "license:check": "addlicense -check src/",
    "types:check": "tsc --project tsconfig.check.json",
    "test": "TS_VERSION=typescript vitest run",
    "test:ts5": "TS_VERSION=typescript-5 vitest run",
    "test:ts7": "TS_VERSION=typescript-7 vitest run",
    "test:all": "npm run test && npm run test:ts5 && npm run test:ts7",
    "check:all": "npm run lint:check && npm run prettier:check && npm run types:check"
  },
  "engines": {
    "node": "^22.23.1 || ^24.0.0 || >=26.0.0",
    "npm": "10.9.8"
  },
  "packageManager": "npm@10.9.8"
}
